# Required: PostgreSQL/Neon connection string. Store real credentials only in server environment.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required for Firebase ID token verification.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# Optional server settings.
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-book-studio-domain.example
MIGRATIONS_DIR=migrations

# Required for real NVIDIA NIM requests.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Required for asset upload/download. This must be persistent storage, not an ephemeral container filesystem.
ASSET_STORAGE_DIR=/var/lib/book-studio/assets

# Google Drive OAuth credentials are not wired until the Drive OAuth adapter is implemented.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URL=
