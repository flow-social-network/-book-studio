# Public API base URL for the Go backend.
NEXT_PUBLIC_BOOK_STUDIO_API_URL=http://localhost:8080

# Firebase Web app configuration. These are public project identifiers, never service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
